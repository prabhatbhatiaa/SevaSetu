{
  "name": "sevasetu-server",
  "version": "1.0.0",
  "description": "Backend API for SevaSetu - Community Service Request and Volunteer Matching Platform",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/seeds/seedData.js",
    "seed:clean": "node src/seeds/seedData.js --clean",
    "seed:admin": "node src/seeds/seedData.js --admin-only",
    "test": "jest --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.1.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "keywords": [
    "sevasetu",
    "volunteer-matching",
    "community-service",
    "geospatial",
    "sdg"
  ],
  "author": "SevaSetu Team",
  "license": "ISC"
}
